# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/wells-management

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration (NodeMailer)
# For Bluehost: 
#   Option 1: smtp.bluehost.com (Port 587 for STARTTLS or 465 for SSL)
#   Option 2: mail.yourdomain.com (e.g., mail.abbarint.com) - Port 465 or 587
# For Gmail: smtp.gmail.com
EMAIL_HOST=smtp.bluehost.com
# Try port 465 (SSL) if 587 (STARTTLS) doesn't work
EMAIL_PORT=587
EMAIL_USER=info@abbarint.com
# Note: If your password contains special characters (like &, >, <, ~, etc.),
# you may need to URL encode them or wrap the password in quotes
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Wells Management System <info@abbarint.com>

# Google Drive Integration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/settings/google-drive/callback
GOOGLE_REFRESH_TOKEN=
# OR use Service Account (recommended for server-to-server)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# File Upload
MAX_FILE_SIZE=50
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,video/mp4,video/mpeg

# Default Super Admin
SUPER_ADMIN_EMAIL=admin@wells.com
SUPER_ADMIN_PASSWORD=Admin@123456